# Runtime environment: dev | test | prod
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://chotu:chotu@localhost:5433/chotu
TEST_DATABASE_URL=postgresql+asyncpg://chotu:chotu@localhost:5433/chotu_test
# Optional; in-memory rate limiting is used when empty or unreachable
REDIS_URL=

# Auth (production startup fails on the default secret)
JWT_SECRET=change-me-dev-secret-change-me-dev-secret
JWT_ISSUER=chotu-gyani
JWT_AUDIENCE=chotu-gyani-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Providers: LLM, STT, TTS
#   LLM_PROVIDER: mock | groq | anthropic
#   STT_PROVIDER / TTS_PROVIDER: mock | groq | gnani
LLM_PROVIDER=groq
STT_PROVIDER=gnani
TTS_PROVIDER=gnani

GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Gnani.ai (Vachana) STT & TTS credentials
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Google Workspace / Gmail & Google Sheets Integration (OAuth & Mail Reminders)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google-sheets/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=
GOOGLE_APPLICATION_CREDENTIALS=

# SMTP Mail Delivery for Customer Reminders
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=true

# Background workers (reminder poller + action expiry)
ENABLE_WORKERS=true
WORKER_POLL_SECONDS=30
ACTION_TTL_MINUTES=15

# Monthly usage limits
USAGE_LIMIT_ASSISTANT_MESSAGES=2000
USAGE_LIMIT_AUDIO_REQUESTS=500
USAGE_LIMIT_AGENT_GENERATIONS=100
